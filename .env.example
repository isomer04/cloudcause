# CloudCause configuration. Copy to .env and edit. Never commit real values.

# ---------------------------------------------------------------------------
# Runtime modes
# ---------------------------------------------------------------------------
# fixtures | live   (live provider APIs are optional and not implemented yet)
CLOUDCAUSE_DATA_MODE=fixtures
# stub | live   Only the default for API clients that omit agent_mode in the
#               request. It gates nothing: the UI chooses per investigation,
#               and a model key below is what makes the live path possible.
CLOUDCAUSE_AGENT_MODE=stub
# inprocess | http  (how the gateway reaches the ADK orchestrator)
CLOUDCAUSE_ORCHESTRATOR_MODE=inprocess
# inprocess | http  (how the orchestrator reaches the AWS/Azure workers)
CLOUDCAUSE_WORKER_MODE=inprocess

# ---------------------------------------------------------------------------
# Service endpoints (used when the modes above are set to http)
# ---------------------------------------------------------------------------
CLOUDCAUSE_ORCHESTRATOR_URL=http://127.0.0.1:8100
CLOUDCAUSE_AWS_WORKER_URL=http://127.0.0.1:8101
CLOUDCAUSE_AZURE_WORKER_URL=http://127.0.0.1:8102
# Gateway URL. The Next.js app in web reads this and proxies the browser's
# requests to it server-side.
CLOUDCAUSE_API_URL=http://127.0.0.1:8000
CLOUDCAUSE_WORKER_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------------
# Investigation history (durable persistence)
# ---------------------------------------------------------------------------
# memory | postgres. Inferred from CLOUDCAUSE_DATABASE_URL when unset, which is
# why it is left unset here: an explicit `memory` outranks the URL, so setting a
# DSN below would keep nothing and say nothing. Uncomment only to force a
# backend against what the URL says.
#
# memory is the default: nothing is written to disk, and history is lost on exit.
# PostgreSQL is the only persisted store; there is no file-backed backend.
# CLOUDCAUSE_HISTORY_BACKEND=
# postgresql://cloudcause:pw@127.0.0.1:5432/cloudcause   needs --extra postgres
# `docker compose -f docker/docker-compose.yml up -d postgres` gets you one.
CLOUDCAUSE_DATABASE_URL=
# How many investigations to keep. Older ones are pruned on each new run.
CLOUDCAUSE_HISTORY_KEEP=50
# How long to wait for the database at startup before degrading to memory.
CLOUDCAUSE_HISTORY_CONNECT_TIMEOUT_SECONDS=5
# Salt for hashing account/subscription ids in stored history. Without it the
# digest is a stable pseudonym, not a secret.
CLOUDCAUSE_ID_HASH_SALT=
# Compose only: password for the local postgres service.
POSTGRES_PASSWORD=cloudcause-local-only

# ---------------------------------------------------------------------------
# Bring your own data (uploaded cost exports)
# ---------------------------------------------------------------------------
# true | false. Off turns every /api/v1/datasets endpoint into a 503 with a
# reason. It defaults to true, but the endpoints still refuse when the topology
# cannot share a dataset: in http mode every process rebuilds provider data from
# an id, so the api, orchestrator, aws-worker, and azure-worker all need the same
# CLOUDCAUSE_DATABASE_URL. Unlike history, the dataset store never degrades to
# memory, because a dataset only the gateway can see would produce a mid-run
# "unknown dataset" or a silent fall-through to the demo fixtures.
#
# Set this to false on any deployment someone else can reach. The gateway is
# unauthenticated, so an open instance accepts anyone's billing export and lets
# anyone who guesses a dataset id read it. true here is for the local offline
# demo, which is what this file configures.
CLOUDCAUSE_UPLOADS_ENABLED=true
# Per-file byte cap, enforced while streaming: refused at the first byte over.
CLOUDCAUSE_UPLOAD_MAX_BYTES=26214400
# Decompressed cap for a .gz upload, plus a ratio cap that stops a bomb.
CLOUDCAUSE_UPLOAD_MAX_DECOMPRESSED_BYTES=209715200
# Rows per file, enforced during parse. Answers 413, not 422.
CLOUDCAUSE_UPLOAD_MAX_ROWS=250000
# Sources per dataset: one cost export plus four evidence files per provider.
CLOUDCAUSE_UPLOAD_MAX_SOURCES=15
# Wall clock for parsing one file, so fifteen files do not share one budget.
CLOUDCAUSE_UPLOAD_TIMEOUT_SECONDS=30
# Normalized daily rows per dataset. This is the cap that matters: in http mode
# the orchestrator, both workers, and every MCP child each load the whole set
# once per investigation.
CLOUDCAUSE_DATASET_MAX_RECORDS=40000
# How long an uploaded dataset lives. Absolute, not extended by use. The report
# it produced is kept in history; the data behind it is not.
CLOUDCAUSE_DATASET_TTL_SECONDS=7200
# Total bytes across every live dataset. A hard refusal, not unbounded growth.
CLOUDCAUSE_DATASET_STORE_MAX_BYTES=536870912

# ---------------------------------------------------------------------------
# Deterministic analytics
# ---------------------------------------------------------------------------
CLOUDCAUSE_MIN_ABSOLUTE_CHANGE=5.0
CLOUDCAUSE_MIN_PERCENT_CHANGE=20.0
CLOUDCAUSE_RECONCILIATION_TOLERANCE=0.05
CLOUDCAUSE_KNOWLEDGE_REVIEW_MAX_AGE_DAYS=180
CLOUDCAUSE_FOCUS_VERSION=1.4

# ---------------------------------------------------------------------------
# Live AI agents (no cloud accounts required)
# ---------------------------------------------------------------------------
# These keys are the whole setup. Add either one and the brief offers "Live AI
# agents" alongside the deterministic playbooks, chosen per run. Left as
# replace-me they count as absent, so the UI offers playbooks only.
# OPENAI_API_KEY drives the AWS (Strands) and Azure (Agent Framework) agents.
# GOOGLE_API_KEY drives the GCP (ADK) agent and the AI report summary.
OPENAI_API_KEY=replace-me
GOOGLE_API_KEY=replace-me

# GOOGLE_API_KEY is an AI Studio key. The ADK agent already defaults this to
# FALSE so the key is used instead of Vertex credentials; set it only to override.
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
CLOUDCAUSE_OPENAI_MODEL=gpt-4.1-mini
# gemini-2.0-flash no longer has a free-tier allowance and returns 429 with
# "limit: 0", so do not go back to it without checking your key's quota.
# gemini-3.7-flash and the gemini-flash-latest alias were both 503 UNAVAILABLE
# when last checked; prefer a pinned, responding model over a moving alias.
CLOUDCAUSE_GEMINI_MODEL=gemini-3.5-flash-lite
# One budget for the whole investigation, shared by every provider's agent.
# A three-provider run splits this across three agents racing concurrently,
# so sizing it for a single provider starves the other two into playbooks.
CLOUDCAUSE_MAX_AGENT_CALLS=48
CLOUDCAUSE_MAX_AGENT_SECONDS=180
# Single-process live-AI guard. Excess live investigations remain queued until
# a slot opens, then fail with an explicit capacity-timeout status if it does not.
CLOUDCAUSE_MAX_CONCURRENT_LIVE_INVESTIGATIONS=2
CLOUDCAUSE_LIVE_QUEUE_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Rate limiting - gateway admission (live investigations only)
# ---------------------------------------------------------------------------
# Bounds how often POST /investigations may start a *live* run. Stub runs are
# never counted or throttled. Rejections return 429 with Retry-After.
CLOUDCAUSE_LIVE_RATE_LIMIT_ENABLED=true
CLOUDCAUSE_LIVE_INVESTIGATIONS_PER_HOUR=3
CLOUDCAUSE_LIVE_INVESTIGATION_BURST=0
CLOUDCAUSE_GLOBAL_LIVE_STARTS_PER_MINUTE=20
# Client identity comes from the direct peer IP, hashed with
# CLOUDCAUSE_ID_HASH_SALT above; the raw address is never stored. Trust
# Forwarded/X-Forwarded-For only behind a proxy you control, since the header
# is otherwise spoofable and would let a client evade its own bucket.
CLOUDCAUSE_TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Rate limiting - outbound provider/model quota
# ---------------------------------------------------------------------------
# Enforced around every OpenAI (AWS + Azure agents) and Gemini (GCP agent, and
# report-synthesis) model call, independent of the admission limit above.
CLOUDCAUSE_OPENAI_MAX_CONCURRENCY=2
CLOUDCAUSE_OPENAI_REQUESTS_PER_MINUTE=20
CLOUDCAUSE_GEMINI_MAX_CONCURRENCY=1
# Outbound Gemini quota limits are configurable deployment-specific targets.
# This and the summary bucket below are independent, so check the active
# project quota, model, and account tier to prevent 429 RESOURCE_EXHAUSTED
# errors, and keep their sum at or under your limit.
CLOUDCAUSE_GEMINI_REQUESTS_PER_MINUTE=8
CLOUDCAUSE_GEMINI_SUMMARY_MAX_CONCURRENCY=1
CLOUDCAUSE_GEMINI_SUMMARY_REQUESTS_PER_MINUTE=4

# ---------------------------------------------------------------------------
# Rate limiting - provider-aware retries
# ---------------------------------------------------------------------------
# Bounded, jittered retries for provider throttling and transient failures
# only; auth, invalid-request, and safety rejections are never retried. Total
# attempts (not retries) within CLOUDCAUSE_MAX_AGENT_SECONDS above.
CLOUDCAUSE_AI_RETRY_ATTEMPTS=3
CLOUDCAUSE_AI_RETRY_BASE_SECONDS=1
CLOUDCAUSE_AI_RETRY_MAX_SECONDS=20

# ---------------------------------------------------------------------------
# Rate limiting - storage backend
# ---------------------------------------------------------------------------
# memory | redis. memory is correct only for a single process, because each
# process holds its own private buckets. That is right for `make dev` and for
# the Cloud Run demo, which runs one instance with everything in one process.
#
# Use redis for any topology with more than one process making model calls.
# docker/docker-compose.yml already does: it runs the orchestrator and both
# workers separately, so on memory each would hold its own OpenAI allowance and
# the combined outbound rate would be a multiple of the configured one.
#
# Note redis also requires CLOUDCAUSE_ID_HASH_SALT above: admission bucket keys
# leave the process, and an unsalted digest of a client IP is reversible. The
# gateway refuses that combination at startup rather than storing them.
CLOUDCAUSE_RATE_LIMIT_BACKEND=memory
CLOUDCAUSE_RATE_LIMIT_REDIS_URL=

# ---------------------------------------------------------------------------
# Live-investigation dispatch (GCP deployment)
# ---------------------------------------------------------------------------
# background keeps today's in-process FastAPI BackgroundTasks path (the local
# and CI default; nothing below is needed). cloud_tasks enqueues onto Cloud
# Tasks and requires every value below plus a reachable private worker
# endpoint that claims and executes the investigation.
CLOUDCAUSE_DISPATCH_MODE=background
CLOUDCAUSE_TASKS_QUEUE=
CLOUDCAUSE_TASKS_LOCATION=
CLOUDCAUSE_TASKS_PROJECT_ID=
CLOUDCAUSE_TASKS_WORKER_URL=
CLOUDCAUSE_TASKS_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Optional live-cloud mode (not implemented yet). Read-only roles only.
# ---------------------------------------------------------------------------
# AWS_PROFILE=
# AWS_REGION=
# AZURE_SUBSCRIPTION_ID=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=
