# CloudCause configuration. Copy to .env and edit. Never commit real values.

# ---------------------------------------------------------------------------
# Runtime modes
# ---------------------------------------------------------------------------
# fixtures | live   (live provider APIs are optional and not implemented yet)
CLOUDCAUSE_DATA_MODE=fixtures
# stub | live       (stub = deterministic agents, costs $0, no network)
CLOUDCAUSE_AGENT_MODE=stub
# inprocess | http  (how the gateway reaches the ADK orchestrator)
CLOUDCAUSE_ORCHESTRATOR_MODE=inprocess
# inprocess | http  (how the orchestrator reaches the AWS/Azure workers)
CLOUDCAUSE_WORKER_MODE=inprocess

# ---------------------------------------------------------------------------
# Service endpoints (used when the modes above are set to http)
# ---------------------------------------------------------------------------
CLOUDCAUSE_ORCHESTRATOR_URL=http://127.0.0.1:8100
CLOUDCAUSE_AWS_WORKER_URL=http://127.0.0.1:8101
CLOUDCAUSE_AZURE_WORKER_URL=http://127.0.0.1:8102
# Gateway URL. The Next.js app in apps/web reads this and proxies the browser's
# requests to it server-side.
CLOUDCAUSE_API_URL=http://127.0.0.1:8000
CLOUDCAUSE_WORKER_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------------
# Investigation history (durable persistence)
# ---------------------------------------------------------------------------
# memory | sqlite | postgres. Inferred from CLOUDCAUSE_DATABASE_URL when unset.
# memory is the default: nothing is written to disk.
CLOUDCAUSE_HISTORY_BACKEND=memory
# sqlite:///.cloudcause/history.sqlite3            local file, no extra install
# postgresql://cloudcause:pw@127.0.0.1:5432/cloudcause   needs --extra postgres
CLOUDCAUSE_DATABASE_URL=
# How many investigations to keep. Older ones are pruned on each new run.
CLOUDCAUSE_HISTORY_KEEP=50
# How long to wait for the database at startup before degrading to memory.
CLOUDCAUSE_HISTORY_CONNECT_TIMEOUT_SECONDS=5
# Salt for hashing account/subscription ids in stored history. Without it the
# digest is a stable pseudonym, not a secret.
CLOUDCAUSE_ID_HASH_SALT=
# Compose only: password for the local postgres service.
POSTGRES_PASSWORD=cloudcause-local-only

# ---------------------------------------------------------------------------
# Bring your own data (uploaded cost exports)
# ---------------------------------------------------------------------------
# true | false. Off turns every /api/v1/datasets endpoint into a 503 with a
# reason. It defaults to true, but the endpoints still refuse when the topology
# cannot share a dataset: in http mode every process rebuilds provider data from
# an id, so the api, orchestrator, aws-worker, and azure-worker all need the same
# CLOUDCAUSE_DATABASE_URL. Unlike history, the dataset store never degrades to
# memory, because a dataset only the gateway can see would produce a mid-run
# "unknown dataset" or a silent fall-through to the demo fixtures.
#
# Set this to false on any deployment someone else can reach. The gateway is
# unauthenticated, so an open instance accepts anyone's billing export and lets
# anyone who guesses a dataset id read it. true here is for the local offline
# demo, which is what this file configures.
CLOUDCAUSE_UPLOADS_ENABLED=true
# Per-file byte cap, enforced while streaming: refused at the first byte over.
CLOUDCAUSE_UPLOAD_MAX_BYTES=26214400
# Decompressed cap for a .gz upload, plus a ratio cap that stops a bomb.
CLOUDCAUSE_UPLOAD_MAX_DECOMPRESSED_BYTES=209715200
# Rows per file, enforced during parse. Answers 413, not 422.
CLOUDCAUSE_UPLOAD_MAX_ROWS=250000
# Sources per dataset: one cost export plus four evidence files per provider.
CLOUDCAUSE_UPLOAD_MAX_SOURCES=15
# Wall clock for parsing one file, so fifteen files do not share one budget.
CLOUDCAUSE_UPLOAD_TIMEOUT_SECONDS=30
# Normalized daily rows per dataset. This is the cap that matters: in http mode
# the orchestrator, both workers, and every MCP child each load the whole set
# once per investigation.
CLOUDCAUSE_DATASET_MAX_RECORDS=40000
# How long an uploaded dataset lives. Absolute, not extended by use. The report
# it produced is kept in history; the data behind it is not.
CLOUDCAUSE_DATASET_TTL_SECONDS=7200
# Total bytes across every live dataset. A hard refusal, not unbounded growth.
CLOUDCAUSE_DATASET_STORE_MAX_BYTES=536870912

# ---------------------------------------------------------------------------
# Deterministic analytics
# ---------------------------------------------------------------------------
CLOUDCAUSE_MIN_ABSOLUTE_CHANGE=5.0
CLOUDCAUSE_MIN_PERCENT_CHANGE=20.0
CLOUDCAUSE_RECONCILIATION_TOLERANCE=0.05
CLOUDCAUSE_KNOWLEDGE_REVIEW_MAX_AGE_DAYS=180
CLOUDCAUSE_FOCUS_VERSION=1.4

# ---------------------------------------------------------------------------
# Live agent mode only (no cloud accounts required)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=replace-me
GOOGLE_API_KEY=replace-me

GOOGLE_GENAI_USE_ENTERPRISE=FALSE
CLOUDCAUSE_OPENAI_MODEL=gpt-4.1-mini
# gemini-2.0-flash no longer has a free-tier allowance and returns 429 with
# "limit: 0", so do not go back to it without checking your key's quota.
CLOUDCAUSE_GEMINI_MODEL=gemini-2.5-flash
# Free-tier request quota is per model. The report summary runs seconds after the
# GCP investigation, so it gets its own model rather than that minute's leftovers.
CLOUDCAUSE_GEMINI_SUMMARY_MODEL=gemini-2.5-flash-lite
CLOUDCAUSE_MAX_AGENT_CALLS=12
CLOUDCAUSE_MAX_AGENT_SECONDS=120

# ---------------------------------------------------------------------------
# Optional live-cloud mode (not implemented yet). Read-only roles only.
# ---------------------------------------------------------------------------
# AWS_PROFILE=
# AWS_REGION=
# AZURE_SUBSCRIPTION_ID=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=
